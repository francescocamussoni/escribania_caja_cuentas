# .env - Variables de entorno para Spec-Kitti Atlassian Sync

# =================================================================
# CREDENCIALES DE ATLASSIAN (Jira y Confluence)
# Generar API Token en: https://id.atlassian.com/manage-profile/security/api-tokens
# =================================================================

# Tu email de Atlassian (usado para Jira y Confluence)
JIRA_EMAIL="tu-email@empresa.com"

# Tu API Token de Atlassian (usado para Jira y Confluence)
JIRA_API_TOKEN="ATATxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# =================================================================
# CONFIGURACIÓN DE TU INSTANCIA
# =================================================================

# URL base de tu instancia de Jira (ej: https://ueno-bank.atlassian.net)
JIRA_BASE_URL="https://tu-empresa.atlassian.net"

# URL base de Confluence si está en un dominio distinto al de Jira (opcional)
# Si no se define, se usa JIRA_BASE_URL también para Confluence
# CONFLUENCE_BASE_URL="https://otra-empresa.atlassian.net"

# Clave del espacio de Confluence predeterminado (ej: "TECH", "DOCS")
CONFLUENCE_SPACE_KEY="TECH"

# =================================================================
# OPCIONAL: Directorio de salida para archivos generados
# =================================================================

SPEC_KITTI_OUTPUT_DIR=".spec-kitti"
