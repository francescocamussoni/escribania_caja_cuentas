# Local development (docker-compose)
# Copy to .env and adjust as needed.

# PostgreSQL (docker-compose service: postgres)
POSTGRES_USER=escribania
POSTGRES_PASSWORD=escribania
POSTGRES_DB=escribania_cajas
POSTGRES_PORT=5432

# Backend — local defaults
BACKEND_PORT=8000
DATABASE_URL=postgresql://escribania:escribania@localhost:5432/escribania_cajas
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_EXPIRE_HOURS=8
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# --- Production (AWS EC2) ---
# Production does NOT use a committed .env file. Secrets are injected at runtime
# from AWS SSM Parameter Store via infra/modules/compute/files/load-env-from-ssm.sh
# (wired in infra/modules/compute/main.tf, ENVIRONMENT=production).
#
# SSM parameters (set in infra/environments/prod.tfvars, stored by Terraform):
#   /escribania/prod/jwt            → JWT_SECRET
#   /escribania/prod/db             → DATABASE_URL (assembled with RDS host/user)
#   /escribania/prod/admin_username → ADMIN_USERNAME
#   /escribania/prod/admin_password → ADMIN_PASSWORD
#   /escribania/prod/cors_origins   → CORS_ORIGINS (CloudFront URL)
#
# Bootstrap on first container start: alembic upgrade head + bootstrap_production
# (15 cajas + admin user from ADMIN_USERNAME / ADMIN_PASSWORD; no dev seed).
